node_modules/
dist/

# graphify knowledge-graph output (generated, untracked)
graphify-out/

# Agent-local project state. `.pi/code-tools/*.py` is Python the agent wrote
# for itself and the repl preamble executes before user code, so committing it
# would hand every future cloner code that runs on their machine. Project trust
# gates it either way (#53); this keeps it from travelling in the first place.
.pi/

# Stryker: mutant sandboxes, HTML report, and incremental cache.
.stryker-tmp/
reports/
.stryker-incremental.json
.stryker-harness-deaths.log

# Claude Code's per-checkout state. The orchestrator puts its agent worktrees
# under .claude/worktrees/, each a full copy of the tree with its own
# biome.json; Biome's scanner then reports "Found a nested root configuration"
# and `npm run lint` fails in the main checkout. Ignored here (Biome honours
# .gitignore), in biome.json (`!!.claude`) and in knip.json. Nothing under it
# is this project's source. See README, "Formatting and lint".
.claude/
