{
  "name": "repl-simple",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension — sandboxed Python execution via Monty",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "repl",
    "extensions",
    "NOTICE"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "test:contained": "node scripts/contained.mjs tsx --test test/*.test.ts",
    "mutation": "REQUIRE_BRIDGE_TOOLS=1 node scripts/contained.mjs --limit 20G stryker run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "check": "tsc --noEmit",
    "coverage": "tsx scripts/coverage.mjs",
    "coverage:update": "tsx scripts/coverage.mjs --update",
    "lint": "biome check --error-on-warnings && knip",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/repl-extension.ts"
    ]
  },
  "dependencies": {
    "@pydantic/monty": "0.0.23"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/tap-runner": "9.6.1",
    "@types/node": "^24.0.0",
    "knip": "6.34.0",
    "tsx": "^4.23.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  }
}
