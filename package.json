{
  "name": "repl-simple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi extension — sandboxed Python execution via Monty",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/repl-extension.ts"
    ]
  },
  "dependencies": {
    "@pydantic/monty": "0.0.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  }
}
